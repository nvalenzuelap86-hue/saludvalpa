# SaludValpa App - Environment Variables Example
# Copy this file to .env.local for local development
# For production, set these variables in Vercel dashboard

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Application title and version
VITE_APP_TITLE=SaludValpa App
VITE_APP_VERSION=1.0.0-alpha
VITE_APP_DESCRIPTION=Sistema de gestión de pacientes y generación de documentos profesionales

# Environment mode
VITE_NODE_ENV=development
VITE_APP_ENV=development # development, staging, production

# ============================================================================
# GOOGLE DRIVE SYNC CONFIGURATION
# ============================================================================

# Google OAuth 2.0 Client ID for Google Drive API
# Create at: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google API Key (optional for some operations)
VITE_GOOGLE_API_KEY=your-google-api-key

# Google OAuth redirect URI (must match configured URI)
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173

# Google Drive folder ID for backups (optional)
VITE_GOOGLE_DRIVE_FOLDER_ID=your-folder-id

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable features
VITE_ENABLE_GOOGLE_SYNC=true
VITE_ENABLE_PWA=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_ANALYTICS=false

# License system configuration
VITE_LICENSE_VALIDATION_URL=https://api.example.com/validate-license
VITE_LICENSE_CHECK_INTERVAL=86400000 # 24 hours in milliseconds

# ============================================================================
# PERFORMANCE & OPTIMIZATION
# ============================================================================

# Cache configuration
VITE_CACHE_DURATION=3600000 # 1 hour in milliseconds
VITE_MAX_CACHE_SIZE=52428800 # 50MB in bytes

# Database configuration
VITE_DB_NAME=saludvalpa_db
VITE_DB_VERSION=1

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================

# Encryption key for sensitive data (should be strong in production)
VITE_ENCRYPTION_KEY=your-encryption-key-here

# Session timeout (in milliseconds)
VITE_SESSION_TIMEOUT=3600000 # 1 hour

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================

# Google Analytics (optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Error tracking (Sentry, etc.)
VITE_SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/xxxxxx

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

# API endpoints
VITE_API_BASE_URL=https://api.example.com
VITE_API_TIMEOUT=30000 # 30 seconds

# PDF generation service (if external)
VITE_PDF_SERVICE_URL=https://pdf-service.example.com

# ============================================================================
# DEVELOPMENT & DEBUGGING
# ============================================================================

# Debug mode
VITE_DEBUG=true
VITE_LOG_LEVEL=debug # error, warn, info, debug

# Mock data for development
VITE_USE_MOCK_DATA=false
VITE_MOCK_DELAY=500 # Delay for mock API responses

# ============================================================================
# PWA CONFIGURATION
# ============================================================================

# PWA update check interval
VITE_PWA_UPDATE_CHECK_INTERVAL=3600000 # 1 hour

# Offline fallback page
VITE_OFFLINE_FALLBACK_PAGE=/offline.html

# ============================================================================
# NOTES
# ============================================================================

# 1. All VITE_* variables are exposed to the client-side code
# 2. For server-side only variables, don't prefix with VITE_
# 3. Never commit actual secrets to version control
# 4. For production, use Vercel environment variables or similar secure storage
# 5. Local development uses .env.local (gitignored)
# 6. Test environment uses .env.test (gitignored)

# ============================================================================
# REQUIRED FOR PRODUCTION
# ============================================================================

# The following must be set in production:
# - VITE_GOOGLE_CLIENT_ID (real Google OAuth client ID)
# - VITE_GOOGLE_API_KEY (if using Google APIs)
# - VITE_ENCRYPTION_KEY (strong encryption key)

# ============================================================================
# OPTIONAL FOR PRODUCTION
# ============================================================================

# The following are optional but recommended:
# - VITE_GA_MEASUREMENT_ID (for analytics)
# - VITE_SENTRY_DSN (for error tracking)
# - VITE_API_BASE_URL (if using external API)